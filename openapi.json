  "components": {
    "schemas": {
      "ApiResponse": {
        "properties": {
          "success": {
            "title": "Success",
            "type": "boolean"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "data": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "title": "Data"
          },
          "meta": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meta"
          }
        },
        "required": [
          "success",
          "message"
        ],
        "title": "ApiResponse",
        "type": "object"
      },
      "BootstrapIn": {
        "properties": {
          "company_name": {
            "description": "Initial company name for password-based bootstrap.",
            "example": "Raj Retail",
            "title": "Company Name",
            "type": "string"
          },
          "email": {
            "description": "Admin email address.",
            "example": "admin@example.com",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "description": "Initial superadmin password.",
            "example": "admin123",
            "title": "Password",
            "type": "string"
          },
          "full_name": {
            "description": "Initial superadmin full name.",
            "example": "Raj Patel",
            "title": "Full Name",
            "type": "string"
          },
          "phone": {
            "default": "",
            "description": "Optional admin phone number.",
            "example": "9999999999",
            "title": "Phone",
            "type": "string"
          }
        },
        "required": [
          "company_name",
          "email",
          "password",
          "full_name"
        ],
        "title": "BootstrapIn",
        "type": "object"
      },
      "SendOtpIn": {
        "properties": {
          "phone": {
            "description": "Phone number that will receive or simulate the OTP.",
            "example": "9999999999",
            "title": "Phone",
            "type": "string"
          },
          "purpose": {
            "default": "login",
            "description": "OTP purpose. Supported values: login, signup.",
            "example": "login",
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": [
          "phone"
        ],
        "title": "SendOtpIn",
        "type": "object"
      },
      "VerifyOtpIn": {
        "properties": {
          "phone": {
            "description": "Phone number used for OTP generation.",
            "example": "9999999999",
            "title": "Phone",
            "type": "string"
          },
          "code": {
            "description": "Six digit OTP code returned by send-otp in development mode.",
            "example": "123456",
            "title": "Code",
            "type": "string"
          },
          "full_name": {
            "default": "",
            "description": "Optional full name used when creating a new user.",
            "example": "Raj Patel",
            "title": "Full Name",
            "type": "string"
          },
          "device_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "",
            "description": "Readable device label for the session.",
            "example": "Main Counter",
            "title": "Device Name"
          }
        },
        "required": [
          "phone",
          "code"
        ],
        "title": "VerifyOtpIn",
        "type": "object"
      },
      "LoginIn": {
        "properties": {
          "login": {
            "description": "Username, email, or phone number.",
            "example": "admin@example.com",
            "title": "Login",
            "type": "string"
          },
          "password": {
            "description": "Account password.",
            "example": "admin123",
            "title": "Password",
            "type": "string"
          },
          "device_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "",
            "description": "Readable device label for the session.",
            "example": "Main Counter",
            "title": "Device Name"
          }
        },
        "required": [
          "login",
          "password"
        ],
        "title": "LoginIn",
        "type": "object"
      },
      "IdentityAuthIn": {
        "properties": {
          "provider": {
            "description": "Identity provider. Use 'google' for Google Sign-In and 'otp' for OTP completion.",
            "example": "google",
            "title": "Provider",
            "type": "string"
          },
          "id_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Verified Google ID token returned by Google Sign-In on the frontend. Required for google-login.",
            "example": "eyJhbGciOiJSUzI1NiIsImtpZCI6Ij...google-id-token...",
            "title": "Id Token"
          },
          "provider_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Provider-specific subject identifier. Usually filled by the backend after Google token verification.",
            "example": "117200475532672775645",
            "title": "Provider User Id"
          },
          "phone": {
            "default": "",
            "description": "Phone number, mainly used by OTP-based onboarding.",
            "example": "9999999999",
            "title": "Phone",
            "type": "string"
          },
          "email": {
            "default": "",
            "description": "Fallback email if already known. Google login normally fills this from the verified token.",
            "example": "raj@example.com",
            "title": "Email",
            "type": "string"
          },
          "full_name": {
            "default": "",
            "description": "Fallback full name if already known. Google login normally fills this from the verified token.",
            "example": "Raj Patel",
            "title": "Full Name",
            "type": "string"
          },
          "device_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "",
            "description": "Readable device label for the session.",
            "example": "Owner Laptop",
            "title": "Device Name"
          }
        },
        "required": [
          "provider"
        ],
        "title": "IdentityAuthIn",
        "type": "object"
      },
      "GoogleLoginIn": {
        "properties": {
          "provider": {
            "default": "google",
            "description": "Frontend provider identifier. Keep this value as 'google'.",
            "example": "google",
            "title": "Provider",
            "type": "string"
          },
          "id_token": {
            "description": "Google ID token returned by the frontend Google Sign-In flow. Send this exact token to the backend for server-side verification.",
            "example": "eyJhbGciOiJSUzI1NiIsImtpZCI6Ij...google-id-token...",
            "title": "Id Token",
            "type": "string"
          },
          "device_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "",
            "description": "Readable device label for the current sign-in, such as browser, laptop, or counter name.",
            "example": "Owner Laptop",
            "title": "Device Name"
          }
        },
        "required": [
          "id_token"
        ],
        "title": "GoogleLoginIn",
        "type": "object"
      },
      "RoleIn": {
        "properties": {
          "name": {
            "example": "Branch Supervisor",
            "title": "Name",
            "type": "string"
          },
          "code": {
            "example": "branch-supervisor",
            "title": "Code",
            "type": "string"
          },
          "description": {
            "default": "",
            "example": "Handles branch sales and approvals.",
            "title": "Description",
            "type": "string"
          },
          "is_cashier": {
            "default": false,
            "example": false,
            "title": "Is Cashier",
            "type": "boolean"
          },
          "is_store_manager": {
            "default": false,
            "example": true,
            "title": "Is Store Manager",
            "type": "boolean"
          },
          "permission_codenames": {
            "example": [
              "sales_view",
              "sales_create",
              "returns_approve"
            ],
            "items": {
              "type": "string"
            },
            "title": "Permission Codenames",
            "type": "array"
          }
        },
        "required": [
          "name",
          "code"
        ],
        "title": "RoleIn",
        "type": "object"
      },
      "RoleUpdateIn": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
