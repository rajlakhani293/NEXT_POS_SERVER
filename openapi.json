    "/api/accounts/google-login": {
      "post": {
        "operationId": "apps_accounts_api_googleLogin",
        "summary": "Googlelogin",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            }
          }
        },
        "description": "Frontend Google Sign-In contract.\n\nFrontend flow:\n1. Complete Google Sign-In in the browser or app.\n2. Read the Google `credential` / ID token from Google.\n3. Send it here as:\n   {\n     \"provider\": \"google\",\n     \"id_token\": \"<google-id-token>\",\n     \"device_name\": \"Owner Laptop\"\n   }\n\nBackend flow:\n- verify the ID token with Google\n- create or find the user\n- auto-create placeholder company and Main Branch when the user is new\n- return your app bearer token for future API requests",
        "tags": [
          "accounts"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoogleLoginIn"
              }
            }
          },
          "required": true
        }
      }
    },
